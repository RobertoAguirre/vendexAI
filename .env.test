# Configuración para tests
NODE_ENV=test
PORT=3001

# Base de datos de test
MONGODB_URI=mongodb://localhost:27017/vendex-ai-test
REDIS_URL=redis://localhost:6379/1

# API Keys de test (usar keys de desarrollo)
ANTHROPIC_API_KEY=test_anthropic_key

# JWT para tests
JWT_SECRET=test_jwt_secret_key_for_testing_only
JWT_EXPIRES_IN=1h

# Logging para tests
LOG_LEVEL=error