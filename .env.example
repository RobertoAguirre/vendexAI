# Ejemplo de variables de entorno para Vendex AI Sales Assistant
# Copia este archivo como .env y completa los valores

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/vendex-ai
# Para producción usar MongoDB Atlas:
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/vendex-ai

# Claude AI (REQUERIDO)
ANTHROPIC_API_KEY=tu_api_key_de_claude_aqui

# JWT
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info